<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Sửa Data Source cho đúng máy của bạn: "." , ".\SQLEXPRESS" , "(localdb)\MSSQLLocalDB" ... -->
    <add name="HRMDB"
         connectionString="Data Source=.;Initial Catalog=HRMDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
